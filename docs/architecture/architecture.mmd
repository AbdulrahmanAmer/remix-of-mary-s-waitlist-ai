node_visitor(("Visitor"))
node_ai_gateway{{"AI model gateway"}}
node_spreadsheet[("Spreadsheet service")]

node_visitor -->|"opens"| node_landing
node_landing -->|"renders"| node_boot
node_boot -->|"starts"| node_experience_ui
node_experience_ui -->|"updates state"| node_presence
node_experience_ui -->|"shows progress"| node_progress_ui
node_experience_ui -->|"saves progress"| node_local_progress
node_experience_ui -->|"requests turns"| node_turn_api
node_turn_api -->|"loads context"| node_experience_memory
node_turn_api -->|"builds prompt"| node_prompt_logic
node_prompt_logic -->|"grounds fields"| node_grounding
node_turn_api -->|"streams generation"| node_ai_gateway
node_experience_ui -->|"captures and plays"| node_audio_engine
node_audio_engine -->|"filters echo"| node_voice_logic
node_audio_engine -->|"detects speech"| node_voice_detector
node_experience_ui -->|"submits audio"| node_transcribe_api
node_experience_ui -->|"requests speech"| node_speech_api
node_experience_ui -->|"submits signup"| node_lead_sync
node_lead_sync -->|"posts lead"| node_lead_api
node_lead_api -->|"writes lead"| node_sheets
node_sheets -.->|"stores rows"| node_spreadsheet
node_experience_ui -.->|"requests addressee"| node_addressee_api
node_experience_ui -.->|"requests reflection"| node_reflect_api

