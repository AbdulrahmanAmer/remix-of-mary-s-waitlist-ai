flowchart TD

subgraph group_edge["Cloudflare edge"]
  node_domain["Custom domain + DNS"]
  node_waf["WAF rate-limit rule<br/>[/api/*]"]
  node_turnstile["Turnstile<br/>[bot check on Start]"]
  node_access["Cloudflare Access<br/>[owner view]"]
end

subgraph group_experience["Waitlist experience (browser)"]
  node_landing["Landing route<br/>[index.tsx]"]
  node_boot["Boot gate<br/>[boot-gate.tsx]"]
  node_experience_ui["MARY experience<br/>[mary-experience.tsx]"]
  node_presence["MARY presence<br/>[mary-presence.tsx]"]
  node_progress_ui["Progress display<br/>[progress-constellation.tsx]"]
  node_call_adapter["Retell call adapter<br/>[retell-call.ts] NEW"]
  node_typing["Typing fallback<br/>[mary-stream.ts]"]
  node_local_progress[("Local progress<br/>[waitlist-store.ts]")]
end

subgraph group_worker["Cloudflare Worker - TanStack Start via Nitro cloudflare-module"]
  node_assets[("Static assets<br/>[public/ incl. logo]")]
  node_guard["API guard<br/>[api-guard.ts]"]
  node_webcall["Start call<br/>[api/retell/web-call] NEW"]
  node_savelead["Save lead function<br/>[api/retell/functions/save-lead] NEW"]
  node_webhook["Call webhook<br/>[api/retell/webhook] NEW"]
  node_llm_socket["MARY brain socket (option A)<br/>[api/retell/llm] NEW"]
  node_turn_api["Turn stream (typing)<br/>[turn.ts]"]
  node_lead_api["Lead endpoint<br/>[lead.ts]"]
  node_prompt_logic["Prompt and grounding<br/>[mary-prompt.server.ts]"]
  node_grounding["Field grounding<br/>[mary-grounding.ts]"]
  node_experience_memory["Debrief and field notes<br/>[mary-experience.server.ts]"]
  node_provider["AI provider seam<br/>[ai-provider.server.ts] NEW"]
  node_sheets["Sheet bridge<br/>[sheets.server.ts]"]
end

subgraph group_platform["Cloudflare platform"]
  node_ratelimit[("Rate Limiting binding")]
  node_secrets[("Worker secrets<br/>[wrangler secret]")]
  node_ai_gateway{{"AI Gateway<br/>[logs, cache, limits]"}}
  node_logs[("Workers Logs")]
  node_d1[("D1 leads<br/>[optional, D2]")]
end

subgraph group_delivery["Delivery"]
  node_repo["GitHub main"]
  node_ci["CI: typecheck, lint, test, build<br/>[ci.yml]"]
  node_deploy["wrangler deploy<br/>[wrangler.jsonc] NEW"]
end

subgraph group_external["External services"]
  node_retell{{"Retell voice agent<br/>STT, turn-taking, TTS"}}
  node_llm{{"LLM provider<br/>OpenAI or Anthropic"}}
  node_spreadsheet[("Google Sheet<br/>[mary-sheets-script]")]
end

node_visitor(("Visitor"))
node_owner(("Owner"))

node_visitor -->|"opens"| node_domain
node_domain -->|"serves"| node_landing
node_landing -->|"renders"| node_boot
node_boot -->|"starts"| node_experience_ui
node_experience_ui -->|"updates state"| node_presence
node_experience_ui -->|"shows progress"| node_progress_ui
node_experience_ui -->|"saves progress"| node_local_progress
node_experience_ui -->|"loads logo"| node_assets
node_experience_ui -->|"passes check"| node_turnstile
node_experience_ui -->|"starts voice"| node_call_adapter
node_call_adapter -->|"requests call"| node_waf
node_waf -->|"forwards"| node_guard
node_guard -->|"checks quota"| node_ratelimit
node_guard -->|"routes"| node_webcall
node_webcall -->|"verifies token"| node_turnstile
node_webcall -->|"create-web-call"| node_retell
node_webcall -.->|"access token"| node_call_adapter
node_call_adapter <-->|"WebRTC audio + transcript"| node_retell
node_retell -->|"calls save_lead"| node_savelead
node_retell -->|"call_ended / call_analyzed"| node_webhook
node_retell -.->|"asks next reply"| node_llm_socket
node_llm_socket -.->|"builds prompt"| node_prompt_logic
node_savelead -->|"grounds fields"| node_grounding
node_savelead -->|"writes lead"| node_sheets
node_webhook -->|"writes outcome"| node_sheets
node_webhook -->|"debriefs"| node_experience_memory
node_experience_ui -->|"types instead"| node_typing
node_typing -->|"requests turns"| node_guard
node_guard -->|"routes"| node_turn_api
node_turn_api -->|"builds prompt"| node_prompt_logic
node_prompt_logic -->|"grounds fields"| node_grounding
node_turn_api -->|"loads notes"| node_experience_memory
node_turn_api -->|"generates"| node_provider
node_experience_memory -->|"generates"| node_provider
node_llm_socket -.->|"generates"| node_provider
node_provider -->|"routes via"| node_ai_gateway
node_ai_gateway -->|"calls"| node_llm
node_experience_memory -->|"stores notes"| node_sheets
node_sheets -->|"writes rows"| node_spreadsheet
node_sheets -.->|"mirror (optional)"| node_d1
node_owner -->|"signs in"| node_access
node_access -->|"protects"| node_lead_api
node_lead_api -->|"reads status"| node_sheets
node_secrets -.->|"keys"| node_guard
node_guard -.->|"logs"| node_logs
node_repo -->|"push"| node_ci
node_ci -->|"green"| node_deploy
node_deploy -->|"publishes"| node_domain

